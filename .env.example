# DRISHTI — Platform Environment Variables
# Copy to .env for local overrides

# Backend Service Configuration
DATABASE_URL=sqlite:///./drishti.db
# For PostgreSQL + PostGIS:
# DATABASE_URL=postgresql://drishti:drishti_secret@localhost:5432/drishti_c4i

REDIS_URL=redis://localhost:6379/0
MQTT_BROKER=localhost
MQTT_PORT=1883
SECRET_KEY=drishti-c4i-border-surveillance-secret-key-2026

# Map Provider Configuration (MapLibre GL JS)
# Options: maptiler | carto | openfreemap
VITE_MAP_PROVIDER=maptiler
# If using MapTiler, supply your public key (works seamlessly with built-in Esri live satellite fallback if left empty):
VITE_MAPTILER_API_KEY=
# Map style: satellite-hybrid | satellite-pure | topo | dataviz-dark | fallback-dark
VITE_MAP_STYLE=satellite-hybrid
# Optional custom style URL:
# VITE_MAP_STYLE_URL=
# Default tactical sector coordinates (BOP-17 North Sector)
VITE_MAP_DEFAULT_LAT=32.7325
VITE_MAP_DEFAULT_LNG=74.8645
VITE_MAP_DEFAULT_ZOOM=14.5

# Frontend API & WebSocket Endpoints
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
